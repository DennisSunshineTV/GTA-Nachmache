# Mallorca's: Street Life – Apache-Regeln für ALL-INKL
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API: alles unter /api/ läuft über api/index.php (Anmeldung, Registrierung, Speicherstand, Admin)
  # Die PHP-Einstiegsdateien selbst nicht noch einmal umschreiben (Apache wertet das Ziel einer Regel erneut aus)
  RewriteRule ^api/(index|status|static)\.php$ - [L]
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Spielcode und Bibliotheken nur für eingeloggte Spieler (api/static.php prüft die Anmeldung)
  RewriteRule ^(game|vendor)/.+$ api/static.php [L,QSA]
</IfModule>

# Dateien des Node-Servers (nur für lokales Entwickeln) und Build-Skripte nicht ausliefern
<FilesMatch "^(server\.js|users\.js|package\.json|package-lock\.json|build\.js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
